TARGET = Sibernetic
RM := rm -rf

# All of the sources participating in the build are defined here
SOURCES = src/owSignalSimulator.cpp \
src/owVtkExport.cpp \
src/main.cpp \
src/owHelper.cpp \
src/owPhysicsFluidSimulator.cpp \
src/owWorldSimulation.cpp \
src/owNeuronSimulator.cpp \
src/owConfigProperty.cpp

ARCH := $(shell uname -m)

# Python linker flags. Default to "-framework Python" (works when a
# fully-formed Python.framework with the top-level Python symlink is
# available, e.g. the runner's pre-installed Python). setup.sh overrides
# this to `python3.13-config --embed --ldflags` so the build links against
# the same Homebrew Python the venv was created with — Homebrew's
# python@3.13 ships the framework headers but omits the top-level symlink
# that `-framework Python` requires, so the framework form fails to link.
PYTHON_LIB_FLAGS ?= -framework Python

ifeq ($(ARCH),arm64)
# Apple Silicon: OpenCL is unavailable; the main binary builds with
# OW_NO_OPENCL and the actual GPU simulation path lives in
# src/metal_diff/sib_metal (built separately via src/metal_diff/build.sh).
ARCH_DEFINES := -DOW_NO_OPENCL
OPENCL_FLAG :=
LIBS := $(PYTHON_LIB_FLAGS) -framework OpenGL -framework GLUT
else
SOURCES += src/owOpenCLSolver.cpp
ARCH_DEFINES :=
OPENCL_FLAG := -framework OpenCL
LIBS := $(PYTHON_LIB_FLAGS) -framework OpenGL -framework GLUT -framework OpenCL
endif

TEST_SOURCES = src/test/owPhysicTest.cpp

SRCEXT := cpp
SRCDIR := src
INCDIR := inc
BUILDDIR = ./Release
BINARYDIR = $(BUILDDIR)/obj
# Change these to set the different python directories
BINARYTESTDIR = $(BINARYDIR)/test
OBJECTS := $(patsubst $(SRCDIR)/%,$(BINARYDIR)/%,$(SOURCES:.$(SRCEXT)=.o))
OBJECTS += $(BINARYTESTDIR)/owPhysicTest.o

CPP_DEPS = $(OBJECTS:.o=.d)

# Change these to set the different python directories
# PYTHONHEADERDIR = /opt/local/Library/Frameworks/Python.framework/Versions/2.7/include/python2.7/
# PYTHONLIBDIR = /opt/local/Library/Frameworks/Python.framework/Versions/2.7/lib/python2.7/
# PYTHONFRAMEWORKDIR = /Library/Frameworks/

# NumPy include directory for fast array access (auto-detect if not set)
NUMPYHEADERDIR ?= $(shell python3 -c "import numpy; print(numpy.get_include())" 2>/dev/null)

# All Target
all: $(TARGET)

# Tool invocations
$(TARGET): $(OBJECTS)
	@echo 'Building target: $@'
	@echo 'Invoking: clang C++ Linker'
	g++ -std=c++14 -L/usr/lib -F$(PYTHONFRAMEWORKDIR) -L$(PYTHONLIBDIR) -o $(BUILDDIR)/$(TARGET) $(OBJECTS) $(LIBS)
	@echo 'Finished building target: $@'
	@echo ' '

$(BINARYDIR)/%.o: $(SRCDIR)/%.cpp
	@mkdir -p $(BINARYDIR)
	@mkdir -p $(BINARYTESTDIR)
	@echo 'Building file: $<'
	@echo 'Invoking: clang C++ Compiler'
#### use this to compile against homebrew installed python
#### change version number as necessary (2.7.n)
	g++ -std=c++14 -O3 -Wall $(ARCH_DEFINES) -c -I$(PYTHONHEADERDIR) -I$(NUMPYHEADERDIR) -I$(INCDIR) $(OPENCL_FLAG) -fmessage-length=0 -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@:%.o=%.d)" -o "$@" "$<"
	@echo 'Finished building: $<'
	@echo ' '

# Other Targets
clean:
	-$(RM) $(OBJECTS)$(CPP_DEPS) $(BUILDDIR)/$(TARGET)
	-@echo ' '

.PHONY: all clean dependents
.SECONDARY:
