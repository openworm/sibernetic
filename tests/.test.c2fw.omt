# Framework for running automated tests on Open Source Brain
# See https://github.com/OpenSourceBrain/osb-model-validation for more details
 
target: test_c2fw.py
engine: Brian2  # This installs Brian2, but all we really need is a Python environment to run the script in
mep: .test.c2fw.mep
experiments:
  m1:
    observables:
      spike times:
        file: 
          path: ../simulations/test_C2_FW_short/muscles_activity_buffer.dat
          columns: [0, 1]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 0.8
        tolerance: 0
  m10:
    observables:
      spike times:
        file: 
          path: ../simulations/test_C2_FW_short/muscles_activity_buffer.dat
          columns: [0, 10]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 0.03
        tolerance: 0