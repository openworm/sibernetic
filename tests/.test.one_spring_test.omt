# Framework for running automated tests on Open Source Brain
# See https://github.com/OpenSourceBrain/osb-model-validation for more details
 
target: test_one_spring_test.py
engine: Brian2  # This installs Brian2, but all we really need is a Python environment to run the script in
mep: .test.one_spring_test.mep
experiments:
  Test:
    observables:
      spike times:
        file: 
          path: ../simulations/test_opencl_one_spring_test/positions_test_opencl_one_spring_test_type_2.1_index_0.dat
          columns: [0, 2]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 19.5
        tolerance: 0