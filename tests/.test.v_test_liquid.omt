# Framework for running automated tests on Open Source Brain
# See https://github.com/OpenSourceBrain/osb-model-validation for more details
 
target: test_v_test_liquid.py
engine: Brian2  # This installs Brian2, but all we really need is a Python environment to run the script in
mep: .test.v_test_liquid.mep
experiments:
  Test:
    observables:
      spike times:
        file: 
          path: ../simulations/test_opencl_v_test_liquid/positions_test_opencl_v_test_liquid_type_1.1_index_1.dat
          columns: [0, 2]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 50
        tolerance: 0