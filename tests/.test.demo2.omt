# Framework for running automated tests on Open Source Brain
# See https://github.com/OpenSourceBrain/osb-model-validation for more details
 
target: test_demo2.py
engine: Brian2  # This installs Brian2, but all we really need is a Python environment to run the script in
mep: .test.demo2.mep
experiments:
  Test:
    observables:
      spike times:
        file: 
          path: ../simulations/test_opencl_demo2/positions_test_opencl_demo2_type_1.1_index_0.dat
          columns: [0, 2]
          scaling: [1, 1]
        spike detection: 
          method: threshold
          threshold: 94
        tolerance: 0